#! /bin/sh
# @DESC: Manage dotfiles installation

. $DOTFILES/common.sh

continue_after_showing_help=1 
run_args "$0" "$@"

# list commands in the bin directory
if [ -n "$printed_help" ]; then
    if [ -d "$DOTFILES/bin" ]; then
        printf "\n\n${TXT_READY} ${TXT_BOLD}%s${TXT_DEFAULT}\n" "Commands included with dotfiles:"
        # list commands only executable files in the bin directory
        for cmd in "$DOTFILES/bin"/*; do
            if [ -x "$cmd" ]; then
                # exclude directories and non-executable files
                if [ ! -f "$cmd" ]; then
                    continue
                fi
                #exclude the main dotfiles script
                if [ "${cmd##*/}" = "dotfiles" ]; then
                    continue
                fi
                # show each commands description if it exists
                _cmd_metatag_header "$cmd"
                _cmd_parse_metatag "$_cmd_header" "@DESC"
                if _cmd_parse_metatag; then
                    printf "  ${TXT_BLUE}%-15s${TXT_DEFAULT} ${TXT_GRAY}%s${TXT_DEFAULT}\n" "${cmd##*/}" "${_cmd_desc%%\n*}"
                fi
            fi
        done
    fi 
fi 
